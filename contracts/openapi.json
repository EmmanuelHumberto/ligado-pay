{
  "openapi": "3.1.0",
  "info": {
    "title": "Ligado Pay local API",
    "version": "0.2.0",
    "description": "Server-to-server API. Simulated by default. InfinitePay account is production, not sandbox; live creation is disabled by default. Production deployment is not enabled."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3305",
      "description": "Local development only"
    }
  ],
  "security": [
    {
      "serviceToken": []
    }
  ],
  "components": {
    "schemas": {
      "Payment": {
        "type": "object",
        "required": [
          "id",
          "applicationId",
          "receiverId",
          "environment",
          "externalReference",
          "amountCents",
          "currency",
          "state",
          "providerReference",
          "createdAt",
          "provider",
          "simulated",
          "realPaymentsEnabled",
          "checkout"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "applicationId": {
            "type": "string"
          },
          "receiverId": {
            "type": "string"
          },
          "environment": {
            "enum": [
              "sandbox",
              "production"
            ]
          },
          "externalReference": {
            "type": "string"
          },
          "amountCents": {
            "type": "integer",
            "minimum": 1
          },
          "currency": {
            "const": "BRL"
          },
          "state": {
            "enum": [
              "PROCESSING",
              "PENDING",
              "UNCERTAIN",
              "PAID_PIX",
              "REVIEW_REQUIRED"
            ]
          },
          "providerReference": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "provider": {
            "enum": [
              "simulated",
              "infinitepay"
            ]
          },
          "simulated": {
            "type": "boolean"
          },
          "realPaymentsEnabled": {
            "type": "boolean"
          },
          "checkout": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "exclusivePix": {
                "const": false
              },
              "directQrAvailable": {
                "const": false
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Request rejected; no sensitive internal details are returned.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Local 256-bit service token. Never embed in browser/app."
      }
    }
  },
  "paths": {
    "/v1/operations": {
      "get": {
        "description": "Read-only, application/receiver/account scoped operational alerts. Never moves money or automatically expires a financial intent.",
        "responses": {
          "200": {
            "description": "Bounded operational alert report and unsupported provider capabilities"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/payments/{id}/operations": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped audit records and operational alerts"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "description": "Requires payments:operations and payments:read. Audited request or evidence only. Refund/cancellation must be performed in InfinitePay; no financial state is changed.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reasonCode"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "REFUND_REQUEST",
                      "CANCEL_REQUEST",
                      "EVIDENCE_RECORDED"
                    ]
                  },
                  "reasonCode": {
                    "type": "string",
                    "pattern": "^[A-Z_]{3,64}$"
                  },
                  "amountCents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000
                  },
                  "evidenceSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent request recorded; NEEDS_PROVIDER_ACTION, not a completed refund/cancellation"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/payments/{id}/reconciliation": {
      "post": {
        "description": "Requires payments:operations/read. Audited requeue of an existing payment with provider correlation hints. No new charge, no automatic approval.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "orderNsu",
                  "transactionNsu",
                  "slug"
                ],
                "properties": {
                  "orderNsu": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "transactionNsu": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Queued or idempotent replay; asynchronous provider verification required"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/webhooks/infinitepay": {
      "post": {
        "operationId": "receiveInfinitePayHint",
        "security": [],
        "description": "Enabled only with an explicitly scoped notification identity. Public untrusted hint, not proof of payment. Persists only order/transaction/invoice correlation; asynchronous authenticated provider verification determines financial state. Never creates or refunds.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "order_nsu",
                  "transaction_nsu",
                  "invoice_slug"
                ],
                "properties": {
                  "order_nsu": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "transaction_nsu": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "invoice_slug": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Known hint durably queued, duplicate or inaccessible reference ignored; not confirmation of payment"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Process alive, no database access"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Database tables ready; configured provider and creation switch"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/payments": {
      "post": {
        "operationId": "createPayment",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "receiverId",
                  "externalReference",
                  "amountCents",
                  "currency",
                  "method"
                ],
                "properties": {
                  "receiverId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{2,63}$"
                  },
                  "externalReference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "amountCents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000
                  },
                  "currency": {
                    "const": "BRL"
                  },
                  "method": {
                    "const": "pix"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "201": {
            "description": "New payment intent; not confirmation of receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/payment-references/{receiverId}/{externalReference}": {
      "get": {
        "operationId": "lookupPayment",
        "description": "Read-only recovery by opaque external reference. Requires payments:read. Never reserves or sends a creation, including when live creation is disabled. A missing reference does not authorize retrying creation.",
        "parameters": [
          {
            "in": "path",
            "name": "receiverId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,63}$"
            }
          },
          {
            "in": "path",
            "name": "externalReference",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored payment scoped to application, receiver, environment and provider account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "description": "Unknown or inaccessible reference; no creation attempted"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/payments/{id}": {
      "get": {
        "operationId": "getPayment",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment visible to the authenticated application and receiver",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "description": "Unknown or inaccessible payment"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/payments/{id}/check": {
      "post": {
        "operationId": "checkCheckoutPayment",
        "description": "InfinitePay mode only. Requires payments:read and payments:check. Receipt hints are untrusted; the server queries the provider before recording financial state.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "orderNsu",
                  "transactionNsu",
                  "slug"
                ],
                "properties": {
                  "orderNsu": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "transactionNsu": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored financial state after provider check",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "description": "Unknown, inaccessible or mode not configured"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  }
}
