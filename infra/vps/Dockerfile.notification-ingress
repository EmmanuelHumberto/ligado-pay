FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df
WORKDIR /app
ENV NODE_ENV=production
COPY notification-ingress.mjs ./notification-ingress.mjs
ARG SOURCE_SHA256
LABEL org.ligado.notification-source-sha256=$SOURCE_SHA256
USER 10009:10009
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s CMD ["node","-e","fetch('http://127.0.0.1:3344/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node","notification-ingress.mjs"]
